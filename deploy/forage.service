[Unit]
Description=Forage RSS reader
After=network-online.target

[Service]
WorkingDirectory=%h/forage
# Per-host settings live in this file (see README, "Configuration"); the dash makes it optional.
EnvironmentFile=-%h/.config/forage/forage.env
Environment=FORAGE_DATA_DIR=%h/forage-data
Environment=FORAGE_HOST=127.0.0.1
Environment=FORAGE_PORT=8787
ExecStart=%h/forage/.venv/bin/python -m forage
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
