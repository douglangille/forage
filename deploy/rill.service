[Unit]
Description=Rill RSS reader
After=network-online.target

[Service]
WorkingDirectory=%h/rill
Environment=RILL_DATA_DIR=%h/rill-data
Environment=RILL_INBOX_DIR=%h/forge/inbox
Environment=RILL_GIT_ROOT=%h/forge
Environment=RILL_SYNC_SCRIPT=%h/forge/system/scripts/vault-autosync.sh
Environment=RILL_HOST=127.0.0.1
Environment=RILL_PORT=8787
ExecStart=%h/rill/.venv/bin/python -m rill
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
